SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Para el desarrollo local usa .dev.vars (no subir a Git).
# Genera un secreto aleatorio de al menos 32 caracteres; no reutilices el de otra app.
BETTER_AUTH_SECRET=
# En producción, la URL pública exacta. En desarrollo localhost se detecta automáticamente.
BETTER_AUTH_URL=
